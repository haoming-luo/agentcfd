{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/haoming-luo/agentcfd/schemas/analysis-request.schema.json",
  "title": "AgentCFD solver-neutral analysis request 0.1",
  "type": "object",
  "required": ["schema", "model", "procedure", "output"],
  "properties": {
    "schema": {"const": "agentcfd.analysis-request/0.1"},
    "model": {
      "type": "object",
      "required": ["schema", "name", "study", "domain", "fluid", "boundaries", "metadata"]
    },
    "procedure": {
      "oneOf": [
        {
          "type": "object",
          "required": ["type", "relative_tolerance", "maximum_iterations"],
          "properties": {"type": {"const": "steady"}}
        },
        {
          "type": "object",
          "required": [
            "type", "end_time", "initial_time_step", "maximum_time_step",
            "maximum_courant_number", "pressure_velocity_correctors"
          ],
          "properties": {"type": {"const": "transient"}}
        }
      ]
    },
    "initialization": {
      "oneOf": [
        {
          "type": "object",
          "required": ["type", "velocity", "gauge_pressure", "temperature"],
          "properties": {"type": {"const": "uniform"}}
        },
        {
          "type": "object",
          "required": ["type", "maximum_iterations"],
          "properties": {"type": {"const": "potential-flow"}}
        },
        {
          "type": "object",
          "required": ["type", "result", "minimum_trust"],
          "properties": {"type": {"const": "previous-result"}}
        }
      ]
    },
    "mesh": {
      "type": "object",
      "required": [
        "method", "base_size", "growth_rate", "local_sizing",
        "boundary_layers", "quality", "maximum_cells"
      ],
      "properties": {
        "method": {"enum": ["automatic", "structured"]},
        "base_size": {"type": "number", "exclusiveMinimum": 0},
        "growth_rate": {"type": "number", "minimum": 1},
        "local_sizing": {"type": "array"},
        "boundary_layers": {"type": "array"},
        "quality": {"type": "object"},
        "maximum_cells": {"type": "integer", "minimum": 1000}
      },
      "additionalProperties": false
    },
    "output": {
      "type": "object",
      "required": [
        "fields", "histories", "portable_profile", "portable_formats",
        "frames", "checkpoints", "storage", "reports", "views"
      ],
      "properties": {
        "fields": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "histories": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "portable_profile": {"enum": ["visualization", "native", "both"]},
        "portable_formats": {
          "type": "array",
          "items": {"enum": ["xdmf", "npz"]},
          "uniqueItems": true,
          "contains": {"const": "xdmf"}
        },
        "frames": {"type": "object"},
        "checkpoints": {"type": "object"},
        "storage": {"type": "object"},
        "reports": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["type", "name", "every"],
            "properties": {
              "type": {"enum": ["point-probe", "surface-report", "force-report"]},
              "name": {"type": "string", "minLength": 1},
              "every": {"type": "integer", "minimum": 1}
            }
          }
        },
        "views": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "object",
                "required": ["type", "name", "field", "origin", "normal", "camera", "export"],
                "properties": {
                  "type": {"const": "slice"},
                  "name": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"},
                  "field": {"type": "string", "minLength": 1},
                  "origin": {"$ref": "#/$defs/vector3"},
                  "normal": {"$ref": "#/$defs/vector3"},
                  "camera": {"$ref": "#/$defs/viewCamera"},
                  "export": {"$ref": "#/$defs/viewExport"}
                },
                "additionalProperties": false
              },
              {
                "type": "object",
                "required": ["type", "name", "field", "values", "camera", "export"],
                "properties": {
                  "type": {"const": "contour"},
                  "name": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"},
                  "field": {"type": "string", "minLength": 1},
                  "values": {
                    "type": "array",
                    "items": {"type": "number"},
                    "minItems": 1,
                    "uniqueItems": true
                  },
                  "camera": {"$ref": "#/$defs/viewCamera"},
                  "export": {"$ref": "#/$defs/viewExport"}
                },
                "additionalProperties": false
              },
              {
                "type": "object",
                "required": [
                  "type", "name", "field", "seed_start", "seed_end", "seeds",
                  "direction", "camera", "export"
                ],
                "properties": {
                  "type": {"const": "streamlines"},
                  "name": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"},
                  "field": {"type": "string", "minLength": 1},
                  "seed_start": {"$ref": "#/$defs/vector3"},
                  "seed_end": {"$ref": "#/$defs/vector3"},
                  "seeds": {"type": "integer", "minimum": 2},
                  "direction": {"enum": ["forward", "backward", "both"]},
                  "camera": {"$ref": "#/$defs/viewCamera"},
                  "export": {"$ref": "#/$defs/viewExport"}
                },
                "additionalProperties": false
              },
              {
                "type": "object",
                "required": [
                  "type", "name", "field", "start", "end", "samples",
                  "component", "camera", "export"
                ],
                "properties": {
                  "type": {"const": "line-profile"},
                  "name": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"},
                  "field": {"type": "string", "minLength": 1},
                  "start": {"$ref": "#/$defs/vector3"},
                  "end": {"$ref": "#/$defs/vector3"},
                  "samples": {"type": "integer", "minimum": 2},
                  "component": {"enum": [null, "x", "y", "z", "magnitude"]},
                  "camera": {"const": null},
                  "export": {"const": null}
                },
                "additionalProperties": false
              }
            ]
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "vector3": {
      "type": "array",
      "items": {"type": "number"},
      "minItems": 3,
      "maxItems": 3
    },
    "viewCamera": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "required": ["position", "focal_point", "view_up", "parallel_scale"],
          "properties": {
            "position": {"$ref": "#/$defs/vector3"},
            "focal_point": {"$ref": "#/$defs/vector3"},
            "view_up": {"$ref": "#/$defs/vector3"},
            "parallel_scale": {"type": ["number", "null"], "exclusiveMinimum": 0}
          },
          "additionalProperties": false
        }
      ]
    },
    "viewExport": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "required": [
            "size", "screenshot", "animation", "frame_rate",
            "transparent_background"
          ],
          "properties": {
            "size": {
              "type": "array",
              "items": {"type": "integer", "minimum": 64},
              "minItems": 2,
              "maxItems": 2
            },
            "screenshot": {"type": "boolean"},
            "animation": {"enum": [null, "png-sequence", "mp4"]},
            "frame_rate": {"type": "integer", "minimum": 1},
            "transparent_background": {"type": "boolean"}
          },
          "additionalProperties": false
        }
      ]
    }
  }
}
