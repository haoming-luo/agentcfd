{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/haoming-luo/agentcfd/schemas/campaign-sweep.schema.json",
  "title": "AgentCFD campaign execution report 0.1",
  "type": "object",
  "required": [
    "schema", "root", "provider", "result_profile", "requested_count", "processed_count",
    "executed_count", "reused_count", "deduplicated_count", "accepted_count", "failed_count",
    "unaccepted_count", "complete", "successful", "progress", "points",
    "solver_budget", "observation_cost"
  ],
  "properties": {
    "schema": {"const": "agentcfd.campaign-sweep/0.1"},
    "root": {"type": "string"},
    "provider": {"enum": ["reference", "openfoam"]},
    "result_profile": {"enum": ["full-fields", "summary-only"]},
    "requested_count": {"type": "integer", "minimum": 1},
    "processed_count": {"type": "integer", "minimum": 0},
    "executed_count": {"type": "integer", "minimum": 0},
    "reused_count": {"type": "integer", "minimum": 0},
    "deduplicated_count": {"type": "integer", "minimum": 0},
    "accepted_count": {"type": "integer", "minimum": 0},
    "failed_count": {"type": "integer", "minimum": 0},
    "unaccepted_count": {"type": "integer", "minimum": 0},
    "complete": {"type": "boolean"},
    "successful": {"type": "boolean"},
    "progress": {"type": "string"},
    "points": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name", "parameters", "plan_sha256", "result_execution_sha256",
          "execution", "outcome", "run_id", "directory", "accepted",
          "diagnose_command", "error"
        ],
        "properties": {
          "name": {"type": "string"},
          "parameters": {"type": "object"},
          "plan_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "result_execution_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "execution": {"enum": ["executed", "reused", "deduplicated"]},
          "outcome": {"enum": ["accepted", "review", "failed"]},
          "run_id": {"type": ["string", "null"]},
          "directory": {"type": ["string", "null"]},
          "accepted": {"type": "boolean"},
          "diagnose_command": {"type": ["string", "null"]},
          "error": {
            "oneOf": [
              {"type": "null"},
              {
                "type": "object",
                "required": ["type", "message"],
                "properties": {
                  "type": {"type": "string"},
                  "message": {"type": "string"}
                },
                "additionalProperties": false
              }
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "solver_budget": {
      "type": "object",
      "required": ["maximum_runs", "planned_new_runs", "solver_processes_started"],
      "properties": {
        "maximum_runs": {"type": ["integer", "null"], "minimum": 0},
        "planned_new_runs": {"type": "integer", "minimum": 0},
        "solver_processes_started": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "execution_policy": {
      "type": "object",
      "required": [
        "requested_parallel_runs", "effective_parallel_runs",
        "maximum_supported_parallel_runs", "logical_cpu_count", "cpu_limited",
        "automatic_retries", "maximum_attempts_per_identity",
        "memory_estimate_available", "memory_admission",
        "temporary_storage_estimates_complete",
        "concurrent_temporary_peak_bytes", "estimated_final_field_growth_bytes",
        "storage_admission_bytes", "available_temporary_bytes",
        "temporary_storage_within_budget", "storage_admission_within_budget",
        "parallel_ready"
      ],
      "properties": {
        "requested_parallel_runs": {"type": "integer", "minimum": 1, "maximum": 32},
        "effective_parallel_runs": {"type": "integer", "minimum": 0, "maximum": 32},
        "maximum_supported_parallel_runs": {"const": 32},
        "logical_cpu_count": {"type": "integer", "minimum": 1},
        "cpu_limited": {"type": "boolean"},
        "automatic_retries": {"const": 0},
        "maximum_attempts_per_identity": {"const": 1},
        "memory_estimate_available": {"const": false},
        "memory_admission": {"const": "explicit-parallel-bound-not-estimated"},
        "temporary_storage_estimates_complete": {"type": "boolean"},
        "concurrent_temporary_peak_bytes": {"type": ["integer", "null"], "minimum": 0},
        "estimated_final_field_growth_bytes": {"type": ["integer", "null"], "minimum": 0},
        "storage_admission_bytes": {"type": ["integer", "null"], "minimum": 0},
        "available_temporary_bytes": {"type": "integer", "minimum": 0},
        "temporary_storage_within_budget": {"type": ["boolean", "null"]},
        "storage_admission_within_budget": {"type": ["boolean", "null"]},
        "parallel_ready": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "observation_cost": {
      "type": "object",
      "required": ["result_manifests_opened", "field_payloads_opened"],
      "properties": {
        "result_manifests_opened": {"const": 0},
        "field_payloads_opened": {"const": 0}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
