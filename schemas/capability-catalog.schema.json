{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/haoming-luo/agentcfd/schemas/capability-catalog.schema.json",
  "title": "AgentCFD capability catalog 0.1",
  "type": "object",
  "required": ["schema", "capabilities"],
  "properties": {
    "schema": {"const": "agentcfd.capabilities/0.1"},
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "maturity", "scope", "evidence", "limitations"],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
          },
          "maturity": {
            "enum": ["planned", "experimental", "beta", "release"]
          },
          "scope": {"type": "string", "minLength": 1},
          "evidence": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "limitations": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
