{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/haoming-luo/agentcfd/schemas/coupling-manifest.schema.json",
  "title": "AgentCAE CouplingManifest 0.1",
  "type": "object",
  "required": ["schema", "interface", "source_model_sha256", "target", "coordinate_frame", "mesh_sha256", "time_coordinate", "fields"],
  "properties": {
    "schema": {"const": "agentcae.coupling-manifest/0.1"},
    "interface": {"type": "string", "minLength": 1},
    "source_model_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
    "target": {"type": "string", "minLength": 1},
    "coordinate_frame": {"type": "string", "minLength": 1},
    "mesh_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
    "time_coordinate": {"type": "string", "minLength": 1},
    "fields": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "direction", "location", "unit", "conservative"],
        "properties": {
          "name": {"type": "string"},
          "direction": {"enum": ["cfd-to-fem", "fem-to-cfd", "bidirectional", "simulation-to-learning"]},
          "location": {"enum": ["point", "cell", "facet", "global"]},
          "unit": {"type": "string", "minLength": 1},
          "conservative": {"type": "boolean"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
