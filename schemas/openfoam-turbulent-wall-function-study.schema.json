{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/haoming-luo/agentcfd/schemas/openfoam-turbulent-wall-function-study.schema.json",
  "title": "AgentCFD prepared OpenFOAM turbulent wall-function study 0.1",
  "type": "object",
  "required": [
    "schema",
    "model_sha256",
    "quantity",
    "cross_section_cells",
    "nominal_wall_cell_fraction",
    "maximum_iterations",
    "scientific_inputs",
    "cases"
  ],
  "properties": {
    "schema": {"const": "agentcfd.openfoam-turbulent-wall-function-study/0.1"},
    "model_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "quantity": {"const": "flow.darcy_friction_factor"},
    "cross_section_cells": {"type": "integer", "minimum": 2},
    "nominal_wall_cell_fraction": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1},
    "maximum_iterations": {"type": "integer", "minimum": 5},
    "scientific_inputs": {
      "type": "object",
      "required": ["model", "procedure", "output_request"],
      "properties": {
        "model": {"type": "object"},
        "procedure": {"type": "object"},
        "output_request": {"type": "object"}
      },
      "additionalProperties": false
    },
    "cases": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": [
          "index",
          "directory",
          "nut_wall_function",
          "expected_cell_count",
          "case_sha256",
          "result"
        ],
        "properties": {
          "index": {"type": "integer", "minimum": 1, "maximum": 3},
          "directory": {"type": "string", "minLength": 1},
          "nut_wall_function": {
            "enum": [
              "nutUBlendedWallFunction",
              "nutUSpaldingWallFunction",
              "nutkWallFunction"
            ]
          },
          "expected_cell_count": {"type": "integer", "minimum": 1},
          "case_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "result": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
