{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/haoming-luo/agentcfd/schemas/operation-catalog.schema.json",
  "title": "AgentCFD bounded operation catalog 0.1",
  "type": "object",
  "required": ["schema", "operations"],
  "properties": {
    "schema": {"const": "agentcfd.operation-catalog/0.1"},
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "command",
          "effect",
          "description",
          "idempotent",
          "retry_policy",
          "approval_policy",
          "expected_artifacts",
          "destructive",
          "starts_solver",
          "supports_preview",
          "output_contract",
          "mcp_annotations"
        ],
        "properties": {
          "name": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
          "command": {"type": "string", "pattern": "^agentcfd "},
          "effect": {"enum": ["read", "write", "execute"]},
          "description": {"type": "string", "minLength": 1},
          "idempotent": {"type": "boolean"},
          "retry_policy": {
            "enum": ["safe", "state-dependent", "do-not-retry-automatically"]
          },
          "approval_policy": {
            "enum": ["none", "user-write", "user-execution", "user-destructive"]
          },
          "expected_artifacts": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "destructive": {"type": "boolean"},
          "starts_solver": {"type": "boolean"},
          "supports_preview": {"type": "boolean"},
          "output_contract": {"type": ["string", "null"]},
          "mcp_annotations": {
            "type": "object",
            "required": [
              "readOnlyHint",
              "destructiveHint",
              "idempotentHint",
              "openWorldHint"
            ],
            "properties": {
              "readOnlyHint": {"type": "boolean"},
              "destructiveHint": {"type": "boolean"},
              "idempotentHint": {"type": "boolean"},
              "openWorldHint": {"type": "boolean"}
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
