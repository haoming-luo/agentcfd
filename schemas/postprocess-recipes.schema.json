{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/haoming-luo/agentcfd/schemas/postprocess-recipes.schema.json",
  "title": "AgentCFD reproducible post-processing recipes 0.1",
  "type": "object",
  "required": ["schema", "source", "payload_copies", "recipes"],
  "properties": {
    "schema": {"const": "agentcfd.postprocess-recipes/0.1"},
    "source": {"type": "string"},
    "payload_copies": {"const": 0},
    "recipes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "type", "name", "field", "export_field", "association", "script",
          "state_after_launch", "render_outputs_after_launch",
          "data_outputs_after_launch", "shares_field_payload", "camera", "export"
        ],
        "properties": {
          "type": {"enum": ["slice", "contour", "streamlines", "line-profile"]},
          "name": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"},
          "field": {"type": "string", "minLength": 1},
          "export_field": {"type": "string", "minLength": 1},
          "association": {"enum": ["point", "cell"]},
          "script": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]*\\.py$"},
          "state_after_launch": {"type": "string", "pattern": "\\.pvsm$"},
          "render_outputs_after_launch": {
            "type": "array",
            "items": {"type": "string", "minLength": 1},
            "minItems": 1,
            "uniqueItems": true
          },
          "data_outputs_after_launch": {
            "type": "array",
            "items": {"type": "string", "minLength": 1},
            "uniqueItems": true
          },
          "shares_field_payload": {"const": "../fields/fields.xdmf"},
          "camera": {
            "oneOf": [
              {"type": "null"},
              {
                "type": "object",
                "required": ["position", "focal_point", "view_up", "parallel_scale"],
                "properties": {
                  "position": {"$ref": "#/$defs/vector3"},
                  "focal_point": {"$ref": "#/$defs/vector3"},
                  "view_up": {"$ref": "#/$defs/vector3"},
                  "parallel_scale": {"type": ["number", "null"], "exclusiveMinimum": 0}
                },
                "additionalProperties": false
              }
            ]
          },
          "export": {
            "oneOf": [
              {"type": "null"},
              {
                "type": "object",
                "required": [
                  "size", "screenshot", "animation", "frame_rate",
                  "transparent_background"
                ],
                "properties": {
                  "size": {
                    "type": "array",
                    "items": {"type": "integer", "minimum": 64},
                    "minItems": 2,
                    "maxItems": 2
                  },
                  "screenshot": {"type": "boolean"},
                  "animation": {"enum": [null, "png-sequence", "mp4"]},
                  "frame_rate": {"type": "integer", "minimum": 1},
                  "transparent_background": {"type": "boolean"}
                },
                "additionalProperties": false
              }
            ]
          },
          "origin": {"$ref": "#/$defs/vector3"},
          "normal": {"$ref": "#/$defs/vector3"},
          "values": {
            "type": "array",
            "items": {"type": "number"},
            "minItems": 1,
            "uniqueItems": true
          },
          "seed_start": {"$ref": "#/$defs/vector3"},
          "seed_end": {"$ref": "#/$defs/vector3"},
          "seeds": {"type": "integer", "minimum": 2},
          "direction": {"enum": ["forward", "backward", "both"]}
          ,
          "start": {"$ref": "#/$defs/vector3"},
          "end": {"$ref": "#/$defs/vector3"},
          "samples": {"type": "integer", "minimum": 2}
          ,
          "component": {
            "enum": [null, "x", "y", "z", "magnitude", "normal", "tangential"]
          }
        },
        "allOf": [
          {
            "if": {"properties": {"type": {"const": "slice"}}},
            "then": {"required": ["origin", "normal"]}
          },
          {
            "if": {"properties": {"type": {"const": "contour"}}},
            "then": {"required": ["values"]}
          },
          {
            "if": {"properties": {"type": {"const": "streamlines"}}},
            "then": {
              "required": ["seed_start", "seed_end", "seeds", "direction"]
            }
          },
          {
            "if": {"properties": {"type": {"const": "line-profile"}}},
            "then": {"required": ["start", "end", "samples", "component"]}
          }
        ],
        "additionalProperties": false
      }
    },
    "layouts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "type", "name", "views", "columns", "rows", "export", "script",
          "state_after_launch", "render_outputs_after_launch",
          "data_outputs_after_launch", "shares_field_payload"
        ],
        "properties": {
          "type": {"const": "render-layout"},
          "name": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"},
          "views": {
            "type": "array",
            "items": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"},
            "minItems": 2,
            "maxItems": 9,
            "uniqueItems": true
          },
          "columns": {"type": "integer", "minimum": 1, "maximum": 4},
          "rows": {"type": "integer", "minimum": 1, "maximum": 9},
          "export": {
            "oneOf": [
              {"type": "null"},
              {
                "type": "object",
                "required": [
                  "size", "screenshot", "animation", "frame_rate",
                  "transparent_background"
                ],
                "properties": {
                  "size": {
                    "type": "array",
                    "items": {"type": "integer", "minimum": 64},
                    "minItems": 2,
                    "maxItems": 2
                  },
                  "screenshot": {"type": "boolean"},
                  "animation": {"enum": [null, "png-sequence", "mp4"]},
                  "frame_rate": {"type": "integer", "minimum": 1},
                  "transparent_background": {"type": "boolean"}
                },
                "additionalProperties": false
              }
            ]
          },
          "script": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]*\\.py$"},
          "state_after_launch": {"type": "string", "pattern": "\\.pvsm$"},
          "render_outputs_after_launch": {
            "type": "array",
            "items": {"type": "string", "minLength": 1},
            "minItems": 1,
            "uniqueItems": true
          },
          "data_outputs_after_launch": {"type": "array", "maxItems": 0},
          "shares_field_payload": {"const": "../fields/fields.xdmf"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "vector3": {
      "type": "array",
      "items": {"type": "number"},
      "minItems": 3,
      "maxItems": 3
    }
  }
}
