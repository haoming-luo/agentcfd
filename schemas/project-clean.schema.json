{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/haoming-luo/agentcfd/schemas/project-clean.schema.json",
  "title": "AgentCFD safe cleanup report 0.1",
  "type": "object",
  "required": [
    "schema", "root", "applied", "include_retained", "scope", "targets", "preserved",
    "candidate_bytes", "candidate_display", "candidate_file_count",
    "protected_active_run_ids", "protected_recovery_run_ids",
    "protected_retained_run_ids",
    "reclaimed_bytes", "reclaimed_display"
  ],
  "properties": {
    "schema": {"const": "agentcfd.project-clean/0.1"},
    "root": {"type": "string"},
    "applied": {"type": "boolean"},
    "include_retained": {"type": "boolean"},
    "scope": {"const": "temporary-workspaces-only"},
    "targets": {"type": "array", "items": {"type": "object"}},
    "preserved": {"type": "array", "items": {"type": "string"}},
    "protected_active_run_ids": {"type": "array", "items": {"type": "string"}},
    "protected_recovery_run_ids": {"type": "array", "items": {"type": "string"}},
    "protected_retained_run_ids": {"type": "array", "items": {"type": "string"}},
    "candidate_bytes": {"type": "integer", "minimum": 0},
    "candidate_display": {"type": "string"},
    "candidate_file_count": {"type": "integer", "minimum": 0},
    "reclaimed_bytes": {"type": "integer", "minimum": 0},
    "reclaimed_display": {"type": "string"}
  },
  "additionalProperties": false
}
