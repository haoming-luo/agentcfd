{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/haoming-luo/agentcfd/schemas/project-creation-request.schema.json",
  "title": "AgentCFD project creation request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "template", "provider"],
  "properties": {
    "schema": {"const": "agentcfd.project-creation-request/0.1"},
    "template": {
      "enum": ["industrial-pipe", "heated-pipe", "baffle-channel", "imported-internal-flow"]
    },
    "provider": {"enum": ["reference", "openfoam"]},
    "geometry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "unit"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "unit": {"enum": ["m", "mm", "cm", "um", "in", "ft"]},
        "boundary_roles": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "enum": ["inlet", "outlet", "wall", "symmetry", "empty"]
          }
        },
        "role_confirmation": {"const": "accept-name-suggestions"}
      },
      "oneOf": [
        {"required": ["boundary_roles"]},
        {"required": ["role_confirmation"]}
      ]
    },
    "interior_point_m": {"$ref": "#/$defs/vector3"},
    "inlet_velocity_m_s": {"$ref": "#/$defs/vector3"},
    "inlet_mass_flow_kg_s": {"type": "number", "exclusiveMinimum": 0},
    "inlet_total_gauge_pressure_pa": {"type": "number", "exclusiveMinimum": 0},
    "mesh": {
      "type": "object",
      "additionalProperties": false,
      "required": ["base_size_m", "maximum_cells"],
      "properties": {
        "base_size_m": {"type": "number", "exclusiveMinimum": 0},
        "maximum_cells": {"type": "integer", "minimum": 1}
      }
    },
    "flow_distribution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["targets"],
      "properties": {
        "targets": {
          "type": "object",
          "minProperties": 2,
          "additionalProperties": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 1
          }
        },
        "maximum_fraction_error": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "parameters": {
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": {"properties": {"template": {"const": "imported-internal-flow"}}},
      "then": {
        "required": ["geometry", "interior_point_m", "mesh"],
        "properties": {"provider": {"const": "openfoam"}},
        "oneOf": [
          {"required": ["inlet_velocity_m_s"]},
          {"required": ["inlet_mass_flow_kg_s"]},
          {"required": ["inlet_total_gauge_pressure_pa"]}
        ]
      },
      "else": {
        "properties": {
          "geometry": false,
          "interior_point_m": false,
          "inlet_velocity_m_s": false,
          "inlet_mass_flow_kg_s": false,
          "inlet_total_gauge_pressure_pa": false,
          "mesh": false,
          "flow_distribution": false
        }
      }
    },
    {
      "if": {"properties": {"template": {"const": "heated-pipe"}}},
      "then": {
        "properties": {
          "provider": {"const": "openfoam"},
          "parameters": {
            "type": "object",
            "additionalProperties": false,
            "minProperties": 1,
            "properties": {
              "length": {
                "type": "number",
                "exclusiveMinimum": 0,
                "description": "Pipe length in metres."
              },
              "diameter": {
                "type": "number",
                "exclusiveMinimum": 0,
                "description": "Internal pipe diameter in metres."
              },
              "mean_velocity": {
                "type": "number",
                "exclusiveMinimum": 0,
                "description": "Bulk inlet velocity in metres per second."
              },
              "inlet_temperature": {
                "type": "number",
                "exclusiveMinimum": 0,
                "description": "Absolute inlet temperature in kelvin."
              },
              "wall_heat_flux": {
                "type": "number",
                "not": {"const": 0},
                "description": "Signed wall heat flux into the fluid in watts per square metre."
              }
            }
          }
        }
      },
      "else": {"properties": {"parameters": false}}
    },
    {
      "if": {"properties": {"template": {"const": "baffle-channel"}}},
      "then": {"properties": {"provider": {"const": "openfoam"}}}
    }
  ],
  "$defs": {
    "vector3": {
      "type": "array",
      "prefixItems": [
        {"type": "number"},
        {"type": "number"},
        {"type": "number"}
      ],
      "items": false,
      "minItems": 3,
      "maxItems": 3
    }
  }
}
