{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/haoming-luo/agentcfd/schemas/project-initialization.schema.json",
  "title": "AgentCFD project initialization",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "template",
    "root",
    "entrypoint",
    "provider",
    "request_sha256",
    "next_action"
  ],
  "properties": {
    "schema": {"const": "agentcfd.project-initialization/0.1"},
    "template": {
      "enum": [
        "industrial-pipe", "heated-pipe", "baffle-channel",
        "industrial-elbow", "imported-internal-flow"
      ]
    },
    "root": {"type": "string", "minLength": 1},
    "entrypoint": {"type": "string", "minLength": 1},
    "provider": {"enum": ["reference", "openfoam"]},
    "request_sha256": {
      "type": ["string", "null"],
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "generated_geometry": {
      "type": "object",
      "required": ["schema", "managed", "synchronized", "artifact"],
      "properties": {
        "schema": {"const": "agentcfd.generated-geometry-sync/0.1"},
        "managed": {"const": true},
        "synchronized": {"const": true},
        "artifact": {"type": "object"}
      }
    },
    "next_action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "reason"],
      "properties": {
        "command": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"template": {"const": "industrial-elbow"}}},
      "then": {"required": ["generated_geometry"]},
      "else": {"properties": {"generated_geometry": false}}
    }
  ]
}
