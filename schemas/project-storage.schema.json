    "managed_display": {"type": "string"},
    "reclaimable_bytes": {"type": "integer", "minimum": 0},
    "reclaimable_display": {"type": "string"},
    "filesystem": {"type": "object"},
    "categories": {"type": "object"},
    "policy": {"type": "object"},
    "next_action": {"type": ["object", "null"]}
