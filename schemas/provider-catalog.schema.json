{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/haoming-luo/agentcfd/schemas/provider-catalog.schema.json",
  "title": "AgentCFD provider family catalog 0.1",
  "type": "object",
  "required": ["schema", "providers"],
  "properties": {
    "schema": {"const": "agentcfd.provider-catalog/0.1"},
    "providers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "display_name",
          "license",
          "execution_boundary",
          "variants",
          "option_contract"
        ],
        "properties": {
          "name": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"},
          "display_name": {"type": "string", "minLength": 1},
          "license": {"type": "string", "minLength": 1},
          "execution_boundary": {"type": "string", "minLength": 1},
          "variants": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"}
          },
          "option_contract": {
            "type": "object",
            "required": ["accepted", "options"],
            "properties": {
              "accepted": {
                "type": "array",
                "uniqueItems": true,
                "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}
              },
              "options": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["name", "value_type", "effect", "description"],
                  "properties": {
                    "name": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
                    "value_type": {
                      "enum": ["boolean", "integer", "number", "string"]
                    },
                    "effect": {
                      "enum": ["execution", "mesh", "output", "retention"]
                    },
                    "description": {"type": "string", "minLength": 1}
                  },
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
