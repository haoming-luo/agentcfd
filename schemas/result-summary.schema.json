{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/haoming-luo/agentcfd/schemas/result-summary.schema.json",
  "title": "AgentCFD materialized lightweight project result summary 0.2",
  "type": "object",
  "required": [
    "schema", "root", "run_id", "summary", "result", "source_result", "status", "converged",
    "accepted", "trust_level", "provider", "parameters", "quantities",
    "histories", "fields", "available", "check_count", "failed_checks", "provenance",
    "artifact_integrity", "observation_cost", "next_action"
  ],
  "properties": {
    "schema": {"const": "agentcfd.result-summary/0.2"},
    "root": {"type": "string"},
    "run_id": {"type": ["string", "null"]},
    "summary": {"type": "string"},
    "result": {"type": "string"},
    "source_result": {
      "type": "object",
      "required": ["path", "bytes", "sha256"],
      "properties": {
        "path": {"type": "string"},
        "bytes": {"type": "integer", "minimum": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "status": {"type": "string"},
    "converged": {"type": "boolean"},
    "accepted": {"type": "boolean"},
    "trust_level": {"enum": ["not_computed", "computed", "converged", "verified", "validated"]},
    "provider": {"type": "string"},
    "parameters": {"type": "object"},
    "quantities": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["value", "unit", "kind", "description"],
        "properties": {
          "value": {"type": "number"},
          "unit": {"type": ["string", "null"]},
          "kind": {"type": "string"},
          "description": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "histories": {"type": "object"},
    "fields": {"type": "object"},
    "check_count": {"type": "integer", "minimum": 0},
    "available": {
      "type": "object",
      "required": ["quantities", "histories", "fields"],
      "properties": {
        "quantities": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "histories": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "fields": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      },
      "additionalProperties": false
    },
    "failed_checks": {"type": "array", "items": {"type": "object"}},
    "requirements": {"type": "array", "items": {"type": "object"}},
    "provenance": {"type": "object"},
    "artifact_integrity": {
      "type": "object",
      "required": ["verified", "reason", "command"],
      "properties": {
        "verified": {"const": false},
        "reason": {"type": "string"},
        "command": {"type": "string"}
      },
      "additionalProperties": false
    },
    "observation_cost": {
      "type": "object",
      "required": ["summary_json_bytes_read", "result_json_bytes_read", "field_payloads_opened", "artifacts_hashed"],
      "properties": {
        "summary_json_bytes_read": {"type": "integer", "minimum": 0},
        "result_json_bytes_read": {"type": "integer", "minimum": 0},
        "field_payloads_opened": {"const": 0},
        "artifacts_hashed": {"const": 0}
      },
      "additionalProperties": false
    },
    "next_action": {
      "type": "object",
      "required": ["command", "reason"],
      "properties": {
        "command": {"type": "string"},
        "reason": {"type": "string"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
