{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/haoming-luo/agentcfd/schemas/solution-plan.schema.json",
  "title": "AgentCFD inspectable solution plan 0.1",
  "type": "object",
  "required": [
    "schema", "project", "model", "decisions", "readiness", "issues",
    "next_actions", "plan_sha256"
  ],
  "properties": {
    "schema": {"const": "agentcfd.solution-plan/0.1"},
    "project": {
      "type": "object",
      "required": [
        "root", "template", "entrypoint", "entrypoint_sha256", "factory", "parameters",
        "factory_parameters"
      ],
      "properties": {
        "root": {"type": "string"},
        "template": {
          "type": ["string", "null"],
          "enum": [
            null, "industrial-pipe", "heated-pipe", "baffle-channel",
            "industrial-elbow", "imported-internal-flow"
          ]
        },
        "entrypoint": {"type": "string"},
        "entrypoint_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "factory": {"type": "string"},
        "parameters": {
          "type": "object",
          "additionalProperties": {
            "type": ["string", "number", "integer", "boolean", "null"]
          }
        },
        "factory_parameters": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name", "required", "default", "default_type", "overrideable",
              "selected", "current", "input_contract", "metadata"
            ],
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "required": {"type": "boolean"},
              "default": {"type": ["string", "number", "integer", "boolean", "null"]},
              "default_type": {"type": ["string", "null"]},
              "overrideable": {"type": "boolean"},
              "selected": {"type": "boolean"},
              "current": {"type": ["string", "number", "integer", "boolean", "null"]},
              "input_contract": {"enum": ["json-scalar", null]},
              "metadata": {
                "oneOf": [
                  {"type": "null"},
                  {
                    "type": "object",
                    "required": [
                      "kind", "label", "description", "unit", "minimum",
                      "maximum", "exclusive_minimum", "choices", "nullable"
                    ],
                    "properties": {
                      "kind": {"enum": ["number", "integer", "choice"]},
                      "label": {"type": "string", "minLength": 1},
                      "description": {"type": "string", "minLength": 1},
                      "unit": {"type": ["string", "null"]},
                      "minimum": {"type": ["number", "null"]},
                      "maximum": {"type": ["number", "null"]},
                      "exclusive_minimum": {"type": "boolean"},
                      "choices": {
                        "type": "array",
                        "items": {"type": "string"},
                        "uniqueItems": true
                      },
                      "nullable": {"type": "boolean"}
                    },
                    "additionalProperties": false
                  }
                ]
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "model": {
      "type": "object",
      "required": ["name", "sha256", "analysis_sha256", "summary", "reynolds_number"],
      "properties": {
        "name": {"type": "string"},
        "sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "analysis_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "summary": {"type": "object"},
        "reynolds_number": {"type": ["number", "null"]}
      },
      "additionalProperties": false
    },
    "decisions": {
      "type": "object",
      "required": [
        "study", "procedure", "outputs", "initialization", "mesh_intent",
        "provider", "required_capability",
        "mesh_strategy", "solver", "result_profile", "portable_field_bundle",
        "portable_formats", "imported_mesh_plan", "generated_geometry",
        "thermal_preflight"
      ],
      "properties": {
        "study": {"type": "object"},
        "procedure": {"type": "object"},
        "outputs": {"type": "object"},
        "initialization": {"type": ["object", "null"]},
        "mesh_intent": {"type": ["object", "null"]},
        "provider": {"type": "object"},
        "required_capability": {"type": "string"},
        "mesh_strategy": {"type": "string"},
        "solver": {"type": "string"},
        "result_profile": {"enum": ["full-fields", "summary-only"]},
        "portable_field_bundle": {"type": "boolean"},
        "portable_formats": {
          "type": "array",
          "items": {"enum": ["xdmf", "hdf5", "npz"]},
          "uniqueItems": true
        },
        "output_plan": {"type": "object"},
        "imported_mesh_plan": {"type": ["object", "null"]},
        "generated_geometry": {"type": ["object", "null"]},
        "thermal_preflight": {
          "type": "object",
          "required": ["status", "reason", "calculation"],
          "properties": {
            "status": {"enum": ["not-requested", "calculated", "deferred"]},
            "reason": {"type": "string", "minLength": 1},
            "calculation": {
              "type": ["object", "null"],
              "properties": {
                "reynolds_number": {"type": "number", "exclusiveMinimum": 0},
                "prandtl_number": {"type": "number", "exclusiveMinimum": 0},
                "peclet_number": {"type": "number", "exclusiveMinimum": 0},
                "thermal_diffusivity": {"type": "number", "exclusiveMinimum": 0},
                "mass_flow_rate": {"type": "number", "exclusiveMinimum": 0},
                "heat_rate_into_fluid": {"type": "number"},
                "inlet_bulk_temperature": {"type": "number", "exclusiveMinimum": 0},
                "estimated_outlet_bulk_temperature": {"type": "number", "exclusiveMinimum": 0},
                "estimated_bulk_temperature_change": {"type": "number"},
                "absolute_temperature_change_fraction": {"type": "number", "minimum": 0},
                "maximum_temperature_change_fraction": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1},
                "within_declared_temperature_change_limit": {"type": "boolean"}
              },
              "required": [
                "reynolds_number", "prandtl_number", "peclet_number",
                "thermal_diffusivity", "mass_flow_rate", "heat_rate_into_fluid",
                "inlet_bulk_temperature", "estimated_outlet_bulk_temperature",
                "estimated_bulk_temperature_change",
                "absolute_temperature_change_fraction",
                "maximum_temperature_change_fraction",
                "within_declared_temperature_change_limit"
              ],
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "readiness": {
      "type": "object",
      "required": [
        "model_valid", "provider_compatible", "runtime_available",
        "portable_io_available", "input_assets_ready", "mesh_intent_ready",
        "ready_to_run"
      ],
      "properties": {
        "model_valid": {"type": "boolean"},
        "provider_compatible": {"type": "boolean"},
        "runtime_available": {"type": "boolean"},
        "portable_io_available": {"type": "boolean"},
        "input_assets_ready": {"type": "boolean"},
        "mesh_intent_ready": {"type": "boolean"},
        "ready_to_run": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "severity", "message", "path", "repair"],
        "properties": {
          "code": {"type": "string"},
          "severity": {"enum": ["error", "warning", "info"]},
          "message": {"type": "string"},
          "path": {"type": "string"},
          "repair": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "next_actions": {"type": "array", "items": {"type": "string"}},
    "plan_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}
